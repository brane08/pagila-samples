      "Bash(mvn spring-boot:run*)",
      "Bash(mvn quarkus:dev*)",
      "Bash(./mvnw test:*)",
      "Bash(./mvnw verify:*)",
      "Bash(./mvnw compile:*)",
      "Bash(./mvnw package:*)",
      "Bash(./mvnw spring-boot:run*)",
      "Bash(./mvnw quarkus:dev*)",
      "Bash(psql -U postgres -h 127.0.0.1 -d prore -c \"SELECT *)",
      "Bash(psql -U postgres -h localhost -d prore -c \"SELECT *)",
      "Bash(gradle test:*)",
      "Bash(gradle build:*)",
      "Bash(gradle run:*)",
      "Bash(gradle bootRun*)",
      "Bash(gradle quarkusDev*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew run:*)",
      "Bash(./gradlew bootRun*)",
      "Bash(./gradlew quarkusDev*)",
      "Bash(pytest:*)",
      "Bash(pyright:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
