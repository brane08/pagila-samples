      "Bash(npx pyright:*)",
      "Bash(uv run:*)",
      "Bash(uvx:*)",
      "Bash(.venv/bin/*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Mcp"
