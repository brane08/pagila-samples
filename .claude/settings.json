      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(dd *)",
      "Bash(sudo *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(mkfs*)",
      "Bash(format *)",
