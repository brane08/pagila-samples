      "Edit(**/*.yaml)",
      "Edit(**/*.py)",
      "Edit(**/*.go)",
      "Edit(**/*.js)",
      "Edit(**/*.jsx)",
      "Edit(**/*.ts)",
      "Edit(**/*.tsx)",
      "Edit(**/*.html)",
      "Edit(**/*.css)",
      "Edit(**/*.scss)",
      "Edit(**/*.sql)",
      "Edit(**/db/migration/*.sql)",
      "Edit(**/*.json)",
      "Edit(**/*.md)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/memory/*.md)",
      "Edit(.claude/memory/*.yaml)",
      "Edit(.claude/memory/*.yml)",
      "Bash(git:*)",
      "Bash(java:*)",
      "Bash(javac:*)",
      "Bash(mvn test:*)",
      "Bash(mvn verify:*)",
